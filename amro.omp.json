{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .SSHSession }}\uf817 {{ end }}\uf508 {{ .UserName }}",
          "foreground": "#0CA0D8",
          "type": "session",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "style": "full"
          },
          "template": " \uf07b {{ .Path }}",
          "foreground": "#0CA0D8",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \udb80\udd93 {{ .StashCount }}{{ end }}",
          "foreground": "#f3722c",
          "powerline_symbol": "\ue0b0",
          "type": "git",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \udb80\udf1f {{ .Full }}",
          "foreground": "#4063D8",
          "type": "php",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " \udb80\udf99 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }}{{ end }}{{ .Full }}",
          "foreground": "#339933",
          "type": "node",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue738{{ .Full }}",
          "foreground": "#ed8b00",
          "powerline_symbol": "\ue0b0",
          "type": "java",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " \ufcd1{{ .Full }}",
          "foreground": "#00ADD8",
          "powerline_symbol": "\ue0b0",
          "type": "go",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue28e{{ .Full }}",
          "foreground": "#0553B1",
          "type": "flutter",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue753{{ .Full }}",
          "foreground": "#c3002f",
          "type": "angular",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue235{{ .Full }}",
          "foreground": "#906cff",
          "type": "python",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " \ue791{{ .Full }}",
          "foreground": "#cc0000",
          "powerline_symbol": "\ue0b0",
          "type": "ruby",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " 🥟 {{ .Full }}",
          "foreground": "#3C82F6",
          "type": "bun",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue7ad{{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "#FF9900",
          "powerline_symbol": "\ue0b0",
          "type": "aws",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "3:04 PM"
          },
          "template": " [{{ .CurrentDate | date .Format }}]",
          "foreground": "#b4418e",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\ue3bf ",
          "foreground": "#cd5e42",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\ud83d\ude80\u2009",
          "foreground": "#bbbbbb",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
